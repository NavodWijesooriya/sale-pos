rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isApprovedUser(userId) {
      return isOwnUser(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && (
          get(/databases/$(database)/documents/users/$(userId)).data.approvalStatus == 'approved'
          || !get(/databases/$(database)/documents/users/$(userId)).data.keys().hasAny(['approvalStatus'])
        );
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }

    function isPendingRegistrationRequest(userId) {
      return isOwnUser(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.approvalStatus == 'pending';
    }

    function isInitialAdminProfile(userId) {
      return isOwnUser(userId)
        && isAdmin()
        && request.resource.data.role == 'admin'
        && request.resource.data.approvalStatus == 'approved';
    }

    function isAdminApprovalUpdate() {
      return isAdmin()
        && request.resource.data.approvalStatus in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
    }

    match /userRoles/{userId} {
      allow get: if isOwnUser(userId);
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwnUser(userId) || isAdmin();
      allow list: if isAdmin();
      allow delete: if false;
      allow create: if isPendingRegistrationRequest(userId) || isInitialAdminProfile(userId);
      allow update: if isAdminApprovalUpdate()
        || (isOwnUser(userId)
        && (!resource.data.keys().hasAny(['approvalStatus']) || resource.data.approvalStatus == 'approved')
        && (!request.resource.data.keys().hasAny(['approvalStatus']) || request.resource.data.approvalStatus == resource.data.approvalStatus)
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role));

      match /{collectionName}/{documentId} {
        allow read, write: if isApprovedUser(userId);
      }

      match /{collectionName}/{documentId}/{nestedDocument=**} {
        allow read, write: if isApprovedUser(userId);
      }
    }

    // Legacy data remains readable by its recorded owner for one-time migration.
    // All new writes must use the user's private document tree.
    match /bikes/{bikeId} {
      allow get, list: if isApprovedUser(request.auth.uid) && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /userSettings/{userId} {
      allow get: if isOwnUser(userId);
      allow list, create, update, delete: if false;
    }
  }
}
